{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "azoyun-569b2",
          "appId": "1:517819561284:android:d8f5631f7e8d72e1c01311",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "azoyun-569b2",
          "configurations": {
            "android": "1:517819561284:android:d8f5631f7e8d72e1c01311",
            "ios": "1:517819561284:ios:1790d41295fb5868c01311",
            "web": "1:517819561284:web:789006e117993517c01311"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "legacy-rooms",
      "ignore": ["node_modules", ".git", "*.test.mjs"]
    }
  ],
  "hosting": {
    "site": "azoyun",
    "public": "build/salon",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/join/**",
        "destination": "/join/index.html"
      }
    ],
    "headers": [
      {
        "regex": "^[/\\\\]\\.well-known[/\\\\](assetlinks\\.json|apple-app-site-association)$",
        "headers": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "regex": "^[/\\\\](join|arcade3d)([/\\\\].*)?$",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
      },
      {
        "source": "**/*.@(js|mjs|css)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=31536000" }
        ]
      }
    ]
  }
}
